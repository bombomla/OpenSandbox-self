# OpenSandbox audit webhook configuration.
#
# Copy to audit.toml (next to main.py) or set AUDIT_CONFIG_PATH to this
# file's location. All keys are optional; missing keys use the defaults
# shown here.

[server]
host = "0.0.0.0"
port = 8080
# When non-empty, the web UI and query APIs require login with this
# password (event ingestion POST /events is never protected).
ui_password = ""

[database]
url = "postgresql://postgres:postgres@localhost:5432/opensandbox_audit"
pool_min = 1
pool_max = 10

[kubernetes]
# Kubeconfig file path for the cluster sync; empty = default kubeconfig,
# falling back to in-cluster credentials.
kubeconfig = ""
# Namespace whose batchsandboxes.sandbox.opensandbox.io resources mark
# live sandbox ids (the resource name is the sandbox id; required by
# POST /api/sync-deleted).
namespace = ""
# When > 0 (seconds), sync against the cluster periodically in the
# background: discover sandbox ids that have no database row yet
# (inserted as never-accessed rows shown in the UI) and reconcile the
# deleted flags; 0 = manual sync via POST /api/sync-deleted only.
sync_interval = 0

[events]
# Audit events whose URI ends with any of these suffixes (case-insensitive)
# are dropped and not recorded - typically health-check pings, e.g.
# /<sandbox-id>/<port>/ping.
#
# An entry may also carry query parameter names (values are ignored):
# "/usage?days=" matches /usage?days=1, /usage?days=30, /usage?days=1&x=2 ...
excluded_uri_suffixes = ["ping"]
# To exclude more URI suffixes, add them to the array, e.g.:
# excluded_uri_suffixes = ["ping", "healthz", "/status", "/usage?days="]

[whitelist]
# User ids to highlight on the summary page (白名单用户) and to exclude
# from GET /api/sandboxes/times (their sandboxes stay out of the
# usage/lifetime report). Whitelisting does not change access control or
# what gets recorded - every sandbox is audited alike. An empty list
# hides the whitelist card and excludes nothing from the report.
users = []
# users = ["7680071018521559040"]

[alerts]
# Bearer token for the Alertmanager webhook (POST /alerts). When
# non-empty, deliveries must carry it as an Authorization: Bearer <token>
# header - configure the same token in the Alertmanager receiver:
#
#   webhook_configs:
#     - url: http://audit-webhook:8080/alerts
#       http_config:
#         authorization:
#           type: Bearer
#           credentials: "<this token>"
#
# Empty = no authentication (open like POST /events). Independent of
# server.ui_password.
auth_token = ""

# Host memory alerts. A firing alert whose alertname is listed here
# triggers a stale-user lookup for its host: the alert's "instance"
# label (node_exporter style "IP:port" - the port is stripped)
# identifies the host, and the users whose sandboxes on that host were
# not accessed for more than stale_days days (VIP/whitelisted users
# excluded) are logged as a warning and returned in the POST /alerts
# response body as "stale_users" (for downstream automation). Empty
# list = the lookup is off.
memory_alert_names = []
# memory_alert_names = ["HighMemory"]
# Stale-user threshold in days for the memory-alert lookup above.
stale_days = 7

# Auto-stop (自动停止): when enabled, a firing memory alert whose lookup
# found stale users also stops the first stop_limit (most stale) users'
# sandbox services by POSTing {"external_user_id": <user_id>, "slug":
# stop_slug} to stop_url (the claw-catalog stop endpoint). Off by
# default - enable explicitly after a successful stale-user dry run.
stop_sandboxes = false
stop_url = "http://10.68.205.224:8000/claw-catalog/stop"
stop_slug = "v20260427"
# Max users stopped per alerting host.
stop_limit = 10

[log]
level = "INFO"
